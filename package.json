{
  "name": "drepia-reports",
  "version": "1.0.0",
  "description": "Application desktop offline de saisie de donnees et generation automatique des rapports DREPIA (journaliers, hebdomadaires, mensuels)",
  "main": "out/main/index.js",
  "author": "DREPIA Centre",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "chart.js": "^4.4.4",
    "docx": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
